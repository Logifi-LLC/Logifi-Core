# Supabase Configuration
# Copy this file to .env and fill in your Supabase credentials
# 
# To get your Supabase credentials:
# 1. Go to https://supabase.com and create a project (or use an existing one)
# 2. Go to Project Settings > API
# 3. Copy the "Project URL" and "anon public" key

NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: “Beta” / “Coming soon” on the Integrations page (/integrations) and Settings → Data & Sync → Pull from FC View only.
# Does not change who can connect. Values: off (default), beta, coming_soon
# NUXT_PUBLIC_FCV_UI_LABEL=off

# Note: The app can work without Supabase for local-only development
# (uses IndexedDB/localStorage for data persistence)

# FC View Logbook API (server-only; set after receiving access from FC View portal)
#
# Required for /api/fcv/auth (otherwise returns 503 “not configured”):
#   FCV_CLIENT_ID, FCV_CLIENT_SECRET, FCV_REDIRECT_URI, FCV_AUTHORIZE_URL, FCV_TOKEN_URL
# Also required for FC View API calls after connect:
#   FCV_API_BASE_URL
# Callback stores tokens in Supabase — set:
#   SUPABASE_SERVICE_ROLE_KEY
# On Vercel: Project → Settings → Environment Variables → add all of the above → redeploy.
# Enable each variable for Preview (branch deployments) if you test on *.vercel.app URLs — not Production-only.
# The API resolves FCV_* from the live environment at request time (and accepts NUXT_FCV_* aliases).
#
# FCV_CLIENT_ID=
# FCV_CLIENT_SECRET=
# Redirect URI must match EXACTLY what is registered in the FC View OAuth client (scheme, host, port, path).
# If omitted, OAuth handlers derive https://{current-host}/api/fcv/callback from the incoming request
# (useful for Vercel Preview). You must still register that URL with FC View for each deployment host you use.
# FC View requires redirect URIs to start with https:// (http://localhost is rejected in their UI).
# For local dev, serve Nuxt over HTTPS with mkcert, then register and use:
#   FCV_REDIRECT_URI=https://localhost:3000/api/fcv/callback
# Steps:
#   1. Install mkcert, then trust its CA: `mkcert -install`
#      - With Homebrew: `brew install mkcert` (install Homebrew from https://brew.sh if needed).
#        After a fresh Homebrew install, `brew` is not on PATH until you run the “Next steps” it prints,
#        e.g. `eval "$(/opt/homebrew/bin/brew shellenv zsh)"` (Apple Silicon; Intel Mac often `/usr/local/bin/brew`),
#        or run once: `/opt/homebrew/bin/brew install mkcert`
#      - Without Homebrew (macOS): in Terminal run `uname -m` — arm64 = Apple Silicon, x86_64 = Intel.
#        Apple Silicon:
#          mkdir -p ~/bin && curl -sL -o ~/bin/mkcert https://github.com/FiloSottile/mkcert/releases/download/v1.4.4/mkcert-v1.4.4-darwin-arm64 && chmod +x ~/bin/mkcert
#        Intel Mac:
#          mkdir -p ~/bin && curl -sL -o ~/bin/mkcert https://github.com/FiloSottile/mkcert/releases/download/v1.4.4/mkcert-v1.4.4-darwin-amd64 && chmod +x ~/bin/mkcert
#        Add to ~/.zshrc:  export PATH="$HOME/bin:$PATH"
#        Then:  source ~/.zshrc  and  mkcert -install
#      More options: https://github.com/FiloSottile/mkcert#installation
#   2. mkdir -p logifi.web/certs && cd logifi.web/certs
#   3. Generate certs (entire line — do not run `mkcert -key-file` alone):
#        mkcert -key-file localhost-key.pem -cert-file localhost.pem localhost 127.0.0.1
#      Or: `mkcert localhost 127.0.0.1` then use the printed *.pem names in NUXT_DEV_HTTPS_* below.
#   4. In .env:
# NUXT_DEV_HTTPS_KEY=certs/localhost-key.pem
# NUXT_DEV_HTTPS_CERT=certs/localhost.pem
#   5. Open https://localhost:3000 (not http) and run `npm run dev`
# Production:
# FCV_REDIRECT_URI=https://your-app.com/api/fcv/callback
# FCV_TOKEN_URL=
# FCV_AUTHORIZE_URL=
# FCV_API_BASE_URL=

# Optional: Supabase service role key (required for FC View OAuth callback to store tokens server-side;
# also used for Digifi temp image uploads to Supabase Storage)
# SUPABASE_SERVICE_ROLE_KEY=

# Digifi — AI paper logbook scanning (Add Pages /logbook-builder; server-only)
# Set the key matching NUXT_DIGIFI_MODEL (provider inferred from model id prefix).
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Defaults (no env): gemini-3.5-flash; thinking low; 1 API call/page.
# Switch model for A/B testing:
# NUXT_DIGIFI_MODEL=gemini-3.5-flash
# NUXT_DIGIFI_MODEL=claude-sonnet-4-6
# On 429/503/404 only: fallback gemini-3-flash-preview (no Flash-Lite). No retry on weak OCR.
# NUXT_DIGIFI_MODEL=gemini-3.5-flash
# NUXT_DIGIFI_MODEL_FALLBACKS=gemini-3-flash-preview
# NUXT_DIGIFI_GEMINI_THINKING_LEVEL=low
# NUXT_DIGIFI_GEMINI_MAX_OUTPUT_TOKENS=20000
# NUXT_DIGIFI_ENABLE_CAPACITY_MODEL_FALLBACK=true
# NUXT_DIGIFI_ENABLE_RESCUE_SCAN=false
# NUXT_DIGIFI_MAX_SCANS_PER_DAY=10
# Claude-only tuning (ignored when NUXT_DIGIFI_MODEL is gemini-*):
# NUXT_DIGIFI_CLAUDE_TEMPERATURE=0
# NUXT_DIGIFI_CLAUDE_API_VERSION=2023-06-01
# NUXT_DIGIFI_CLAUDE_MAX_OUTPUT_TOKENS=20000
# NUXT_DIGIFI_CLAUDE_ENABLE_THINKING=false
# NUXT_DIGIFI_CLAUDE_THINKING_BUDGET=2048
# A/B debug: log first 500 chars of raw TSV + parse stats
# NUXT_DIGIFI_LOG_RAW_RESPONSE=false

# Digifi phone companion capture — URL in QR/link (must match how you run dev, usually HTTPS with mkcert)
# LAN + phone: `pnpm dev:lan` (not `pnpm dev --host --port 3000` — that misparses and drops HTTPS)
# Dev auto-detects your LAN IP (e.g. 192.168.x.x). Set this to override or if detection picks the wrong interface.
# Include your LAN IP in mkcert: mkcert localhost 127.0.0.1 192.168.1.182
# NUXT_PUBLIC_COMPANION_CAPTURE_ORIGIN=https://192.168.1.182:3000

# Optional: Developers page — Lightning donation (Open Source section). Set address and add a QR image under `public/`.
# These values are baked in at build/deploy from env and static files under `public/` — they are not loaded from your app database.
# NUXT_PUBLIC_LIGHTNING_DONATION_ADDRESS=you@getalby.com
# NUXT_PUBLIC_LIGHTNING_DONATION_QR_PATH=/images/lightning-donation-qr.png
# To hide the QR image slot only: NUXT_PUBLIC_LIGHTNING_DONATION_QR_PATH=

# iOS / Capacitor builds (offline aircraft lookups)
# Before first `npm run cap:sync` from repo root, download the FAA aircraft DB (~50–100MB):
#   npm run update-aircraft-db
# `cap:sync` runs `prepare-ios-data`, which copies server/data/aircraft-database.json → public/data/ for the static bundle.

# Digifi credits — payments (server-only unless noted)
# Mock instant grant for beta testers on dev. Defaults to enabled in `npm run dev`, disabled in production.
# Set true explicitly on staging if Murray needs mock checkout before Stripe/Lightning are wired.
# NUXT_CREDITS_MOCK_ENABLED=true
#
# Stripe Checkout (test mode keys from https://dashboard.stripe.com/test/apikeys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe CLI: stripe listen --forward-to localhost:3000/api/credits/webhook/stripe
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Lightning — OpenNode (default; https://developers.opennode.com)
# LIGHTNING_PROVIDER=opennode
# OPENNODE_API_KEY=...                         # Dashboard → Developers → API keys (use test key first)
# NUXT_PUBLIC_LIGHTNING_PAYMENTS_ENABLED=true  # expose Lightning checkout in UI
#
# Local webhook testing: OpenNode must reach a public HTTPS URL for callback_url.
#   1. ngrok http https://localhost:3000
#   2. OPENNODE_CALLBACK_ORIGIN=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app
#   3. Restart dev; purchase credits → pay on OpenNode hosted checkout
#   4. Confirm POST /api/credits/webhook/lightning returns 200 and credits increase
#
# Optional — BTCPay Server (future self-host path; set LIGHTNING_PROVIDER=btcpay)
# BTCPAY_HOST=https://btcpay.example.com
# BTCPAY_API_KEY=...
# BTCPAY_STORE_ID=...
# BTCPAY_WEBHOOK_SECRET=...
