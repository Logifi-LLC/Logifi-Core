{
  "name": "logifi-core",
  "version": "1.0.0",
  "description": "Logifi engine: composables, validation, utils for logbook apps",
  "type": "module",
  "private": true,
  "scripts": {
    "build:web": "npm run generate --prefix logifi.web",
    "cap:sync": "npm run generate:ios-branding && npm run prepare-ios-data --prefix logifi.web && npm run build:web && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "cap:run:ios": "npm run cap:sync && npx cap run ios",
    "generate:ios-branding": "node scripts/generate-ios-branding.mjs",
    "verify:ios-branding": "node scripts/verify-ios-branding.mjs"
  },
  "main": "./logifi.web/app/index.ts",
  "types": "./logifi.web/app/index.ts",
  "exports": {
    ".": {
      "types": "./logifi.web/app/index.ts",
      "import": "./logifi.web/app/index.ts",
      "default": "./logifi.web/app/index.ts"
    },
    "./composables": {
      "types": "./logifi.web/app/composables/index.ts",
      "import": "./logifi.web/app/composables/index.ts",
      "default": "./logifi.web/app/composables/index.ts"
    },
    "./utils": {
      "types": "./logifi.web/app/utils/index.ts",
      "import": "./logifi.web/app/utils/index.ts",
      "default": "./logifi.web/app/utils/index.ts"
    },
    "./types": {
      "types": "./logifi.web/app/types/index.ts",
      "import": "./logifi.web/app/types/index.ts",
      "default": "./logifi.web/app/types/index.ts"
    }
  },
  "files": [
    "logifi.web/app"
  ],
  "dependencies": {
    "@capacitor/barcode-scanner": "^3.0.2",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1"
  }
}
